# Erfordert: pip install pretty_midi
import pretty_midi

# Neues MIDI-Objekt
midi_data = pretty_midi.PrettyMIDI()

# Instrumente
epiano = pretty_midi.Instrument(program=4)   # Electric Piano
bass = pretty_midi.Instrument(program=33)    # Electric Bass (finger)
guitar = pretty_midi.Instrument(program=26)  # Jazz Guitar
drums = pretty_midi.Instrument(program=0, is_drum=True)

# Tempo (78 BPM)
bpm = 78
beats_per_second = bpm / 60.0
seconds_per_beat = 1 / beats_per_second
bar_duration = 4 * seconds_per_beat  # 4/4-Takt

# Akkordprogression (Cmin9 - Abmaj7 - Fm7 - G7alt)
chords = {
    "Cm9": [48, 51, 55, 62, 67],
    "Abmaj7": [44, 48, 51, 55, 60],
    "Fm7": [41, 44, 48, 51, 55],
    "G7alt": [43, 47, 50, 56, 61],
}
progression = ["Cm9", "Abmaj7", "Fm7", "G7alt"]
num_cycles = 4  # ca. 1 Minute

# E-Piano (Hauptstimme)
for i in range(num_cycles):
    for j, chord_name in enumerate(progression):
        start = (i * len(progression) + j) * bar_duration
        end = start + bar_duration
        for note in chords[chord_name]:
            epiano.notes.append(pretty_midi.Note(velocity=80, pitch=note, start=start, end=end))

# Bassline (ruhig, tief)
bass_notes = [36, 32, 29, 31]  # C, Ab, F, G
for i in range(num_cycles):
    for j, note in enumerate(bass_notes):
        start = (i * len(bass_notes) + j) * bar_duration
        bass.notes.append(pretty_midi.Note(velocity=95, pitch=note, start=start, end=start + bar_duration / 2))

# Gitarre (dezente Akkordanschläge)
for i in range(num_cycles):
    for j, chord_name in enumerate(progression):
        start = (i * len(progression) + j) * bar_duration
        for note in chords[chord_name][::2]:
            guitar.notes.append(pretty_midi.Note(velocity=65, pitch=note + 12, start=start + 0.2, end=start + 1.5))

# Drums (sanftes Groove-Fundament)
for i in range(num_cycles * len(progression)):
    bar_start = i * bar_duration
    for beat in range(4):
        t = bar_start + beat * seconds_per_beat
        # Kick
        if beat in [0, 2]:
            drums.notes.append(pretty_midi.Note(velocity=90, pitch=36, start=t, end=t + 0.1))
        # Snare
        if beat in [1, 3]:
            drums.notes.append(pretty_midi.Note(velocity=70, pitch=38, start=t, end=t + 0.1))
        # Hi-Hat (Achtelnoten)
        for sub in [0, 0.5]:
            drums.notes.append(pretty_midi.Note(velocity=50, pitch=42, start=t + sub * seconds_per_beat, end=t + sub * seconds_per_beat + 0.05))

# Instrumente hinzufügen
midi_data.instruments.extend([epiano, bass, guitar, drums])

# Datei speichern
file_name = "Unerwiderte_Liebe_ChrisGrey_Style_1min.mid"
midi_data.write(file_name)
print(f"MIDI-Datei erstellt: {file_name}")
